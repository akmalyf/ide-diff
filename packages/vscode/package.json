{
  "name": "ide-diff-vscode",
  "displayName": "IDE Diff",
  "description": "JetBrains/PhpStorm-style diff and 3-way merge viewer for VS Code, built on CodeMirror 6",
  "version": "0.1.0",
  "private": true,
  "publisher": "ide-diff",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "diff",
    "merge",
    "jetbrains",
    "phpstorm",
    "intellij",
    "codemirror"
  ],
  "scripts": {
    "build": "vite build -c vite.webview.config.ts && vite build -c vite.extension.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "package": "vsce package --no-dependencies --skip-license --allow-missing-repository"
  },
  "contributes": {
    "commands": [
      {
        "command": "ideDiff.compareWithClipboard",
        "title": "Compare with Clipboard",
        "category": "IDE Diff",
        "icon": "$(diff)"
      },
      {
        "command": "ideDiff.compareSelectedFiles",
        "title": "Compare Selected Files",
        "category": "IDE Diff"
      },
      {
        "command": "ideDiff.compareWithHead",
        "title": "Compare with HEAD",
        "category": "IDE Diff",
        "icon": "$(git-compare)"
      },
      {
        "command": "ideDiff.compareActiveFileWith",
        "title": "Compare Active File With…",
        "category": "IDE Diff"
      },
      {
        "command": "ideDiff.resolveConflicts",
        "title": "Resolve Conflicts (3-way Merge)",
        "category": "IDE Diff",
        "icon": "$(git-merge)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "ideDiff.compareWithClipboard",
          "when": "editorIsOpen"
        },
        {
          "command": "ideDiff.compareWithHead",
          "when": "editorIsOpen"
        },
        {
          "command": "ideDiff.compareActiveFileWith",
          "when": "editorIsOpen"
        },
        {
          "command": "ideDiff.resolveConflicts",
          "when": "editorIsOpen"
        }
      ],
      "explorer/context": [
        {
          "command": "ideDiff.compareSelectedFiles",
          "when": "listMultiSelection && listDoubleSelection && !explorerResourceIsFolder",
          "group": "3_compare@30"
        }
      ],
      "editor/context": [
        {
          "command": "ideDiff.compareWithClipboard",
          "when": "editorTextFocus",
          "group": "9_ideDiff@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "ideDiff.compareWithHead",
          "when": "resourceScheme == file",
          "group": "3_compare@30"
        },
        {
          "command": "ideDiff.compareActiveFileWith",
          "when": "resourceScheme == file",
          "group": "3_compare@31"
        },
        {
          "command": "ideDiff.resolveConflicts",
          "when": "resourceScheme == file",
          "group": "3_compare@32"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "ideDiff.compareWithHead",
          "when": "scmProvider == git && scmResourceGroup =~ /^(workingTree|index|untracked)$/",
          "group": "navigation@30"
        },
        {
          "command": "ideDiff.resolveConflicts",
          "when": "scmProvider == git && scmResourceGroup == merge",
          "group": "navigation@30"
        }
      ]
    }
  },
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@ide-diff/core": "workspace:*",
    "@ide-diff/viewer": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/vscode": "~1.105.0",
    "@vscode/vsce": "^4.0.0"
  }
}
